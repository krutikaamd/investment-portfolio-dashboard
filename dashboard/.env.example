# ── Author credit ────────────────────────────────────────────────────────────
# Shown in the header, footer and exported report. Override per-deployment.
# Defaults to "Krutika Dwivedi & Ciarán Daly" if unset.
# For the solo alt site, set this on that Vercel project to just your name:
#   NEXT_PUBLIC_AUTHORS=Krutika Dwivedi
NEXT_PUBLIC_AUTHORS=

# ── Persistence (Upstash Redis) ──────────────────────────────────────────────
# Required in production (Vercel) so per-user portfolios persist. Locally the
# app falls back to data/portfolios/*.json if these are unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Optional site-wide password gate (HTTP Basic auth) ───────────────────────
# If DASHBOARD_PASSWORD is set, the whole site requires this login. Leave unset
# for open access (needed for the anonymous multi-user mode).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
